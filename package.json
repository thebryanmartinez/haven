{
  "name": "bytefin-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "turbo run typecheck",
    "backend": "pnpm --filter @bytefin/backend dev",
    "gen": "turbo gen",
    "gen:app": "turbo gen app"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@bytefin/config": "workspace:*",
    "@turbo/gen": "^2.10.9",
    "@types/node": "^20",
    "turbo": "^2.10.9",
    "typescript": "^5"
  }
}
